{
  "package": "com.maixiang.pulse",
  "name": "脉象",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/maixiang/icon.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    { "name": "system.router" },
    { "name": "system.app" },
    { "name": "system.device" },
    { "name": "system.configuration" },
    { "name": "system.file" },
    { "name": "system.brightness" },
    { "name": "service.health" }
  ],
  "permissions": [
    { "name": "hapjs.permission.HEALTH" }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 480,
    "background": {
      "features": ["service.health"]
    }
  },
  "router": {
    "entry": "pages/splash",
    "pages": {
      "pages/splash": {
        "component": "index"
      },
      "pages/home": {
        "component": "index"
      },
      "pages/oobe": {
        "component": "index"
      },
      "pages/measurement": {
        "component": "index"
      },
      "pages/dim_showcase": {
        "component": "index"
      },
      "pages/organ_showcase": {
        "component": "index"
      },
      "pages/rec_showcase": {
        "component": "index"
      },
      "pages/pulse_explain": {
        "component": "index"
      },
      "pages/pulse_theory": {
        "component": "index"
      },
      "pages/about": {
        "component": "index"
      }
    }
  },
  "display": {
    "backgroundColor": "#000000",
    "textColor": "#E8DCBE"
  }
}
