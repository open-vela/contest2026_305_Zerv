  width: 100%;
  flex-direction: column;
  align-items: center;
  padding: 44px 40px 80px 40px;
}

.arc-clock {
  width: 480px;
  height: 44px;
  position: relative;
  top: -20px;
  justify-content: center;
}

.clock-char { width: 22px; height: 42px; text-align: center; font-size: 30px; font-weight: bold; color: rgba(110, 91, 65, 0.72); transform-origin: 11px 21px; }
.clock-1 { top: 4px; transform: rotate(-10deg); }
.clock-2 { top: 1px; transform: rotate(-5deg); }
.clock-3 { top: -3px; }
.clock-4 { top: 1px; transform: rotate(5deg); }
.clock-5 { top: 4px; transform: rotate(10deg); }

.app-icon {
  width: 128px;
  height: 128px;
  border-radius: 30px;
}

.app-name {
  font-size: 44px;
  color: #8A5A20;
  margin-top: 10px;
}

.app-ver {
  font-size: 24px;
  color: #8A6E4E;
  margin-top: 4px;
  margin-bottom: 24px;
}

.card {
  width: 400px;
  background-color: #D8CCB2;
  border-radius: 24px;
  padding: 22px 28px;
  margin-bottom: 20px;
}

.col { flex-direction: column; }

.desc {
  width: 100%;
  text-align: center;
  font-size: 26px;
  color: #5A4632;
}

.note {
  width: 100%;
  font-size: 23px;
  color: #5A4632;
  margin-bottom: 10px;
}

.card-head {
  align-items: center;
  margin-bottom: 12px;
}

.head-bar {
  width: 6px;
  height: 28px;
  border-radius: 3px;
  background-color: #C0A050;
  margin-right: 16px;
}

.card-title { font-size: 28px; color: #8A5A20; }

/* 分隔线用独立 div：Vela 对单边 border 支持不完整（border-bottom 会画成整圈） */
.credit-row {
  flex-direction: column;
  padding: 12px 0;
}

.credit-label { font-size: 22px; color: #8A6E4E; }
.credit-value { font-size: 28px; color: #5A4632; margin-top: 4px; }
.credit-sep { width: 100%; height: 2px; background-color: #C0A050; margin-top: 14px; opacity: 0.5; }

.thanks-row {
  font-size: 26px;
  color: #5A4632;
  height: 52px;
}

.footer {
  width: 380px;
  text-align: center;
