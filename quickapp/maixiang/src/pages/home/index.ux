  width: 340px;
  height: 34px;
  text-align: center;
  font-size: 22px;
  color: #8B7658;
}

.wave-card {
  width: 390px;
  height: 190px;
  flex-direction: column;
  align-items: center;
  background-color: #CEC1A5;
  border-radius: 30px;
  padding-top: 14px;
  margin-top: 8px;
}

.wave-label {
  width: 320px;
  height: 28px;
  text-align: center;
  font-size: 22px;
  color: #82653C;
}

.wave-hint {
  width: 320px;
  height: 30px;
  text-align: center;
  font-size: 20px;
  color: #725A38;
  margin-top: 8px;
}

.constitution-card {
  width: 390px;
  height: 160px;
  align-items: center;
  background-color: #D8CCB2;
  border-radius: 24px;
  padding-left: 22px;
  margin-top: 18px;
}

