  width: 290px;
  height: 45px;
  font-size: 19px;
  color: #675037;
}

.data-card {
  width: 390px;
  flex-direction: column;
  align-items: center;
  background-color: #D8CCB2;
  border-radius: 24px;
  padding: 18px 20px;
  margin-top: 18px;
}

.card-head {
  width: 350px;
  height: 38px;
  justify-content: space-between;
}

.card-title {
  width: 180px;
