  width: 22px;
  height: 42px;
  text-align: center;
  font-size: 30px;
  font-weight: bold;
  color: rgba(110, 91, 65, 0.72);
  transform-origin: 11px 21px;
}

.clock-1 { top: 4px; transform: rotate(-10deg); }
.clock-2 { top: 1px; transform: rotate(-5deg); }
.clock-3 { top: -3px; }
.clock-4 { top: 1px; transform: rotate(5deg); }
.clock-5 { top: 4px; transform: rotate(10deg); }

.pulse-name {
  width: 340px;
  height: 62px;
  text-align: center;
  font-size: 50px;
  color: #B77B22;
}

